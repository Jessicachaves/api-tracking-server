# Porta do Servidor
PORT=3000

# Meta (Facebook) Conversions API (CAPI)
PIXEL_ID=seu_pixel_id_aqui
ACCESS_TOKEN=seu_access_token_aqui

# Código de teste de eventos (remover em produção)
TEST_EVENT_CODE=

# Segredo de validação da assinatura do Webhook (HMAC-SHA1)
WEBHOOK_SECRET=

# 'true' se a plataforma de pagamento envia o valor em centavos (ex: R$ 197,00 enviado como 19700)
VALUE_IN_CENTS=true

# Versão da Graph API da Meta
API_VERSION=v21.0
